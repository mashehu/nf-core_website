---
import ListingLayout from "@layouts/ListingLayout.astro";
import ComponentListing from "@components/component/ComponentListing.svelte";
import { renderMarkdown } from "@root/bin/satteri/markdownConfig.ts";

import components from "@public/components.json";

// Only pass the fields ComponentListing/ComponentCard read: island props are serialised into the page,
// and the full entries (inputs, outputs, tools, files, ...) are several MB
const modules = await Promise.all(
    components.modules.map(async ({ name, type, meta, pipelines }) => ({
        name,
        type,
        meta: {
            name: meta.name,
            description: meta.description,
            description_rendered: meta.description ? (await renderMarkdown(meta.description)).html : undefined,
            keywords: meta.keywords,
            deprecated: meta.deprecated,
        },
        // Only the names are shown; sorting uses the count
        pipelines: pipelines?.map((p) => ({ name: p.name })),
    })),
);

const title = "nf-core/modules";
const description = "Browse the " + modules.length + " modules that are currently available as part of nf-core.";
---

<ListingLayout
    {title}
    {description}
    filter={[]}
    sortBy={["Name", "# Pipeline integrations"]}
    searchExamples={[
        { query: "k:STR", label: "keywords" },
        { query: "n:samtools", label: "name" },
        { query: "d:cluster", label: "description" },
        { query: 'k:"STR"', label: "exact keyword" },
    ]}
    displayStyle={[
        { name: "grid", icon: "fa-regular fa-grid-2" },
        { name: "table", icon: "fa-regular fa-bars" },
    ]}
    viewTransitions={true}
>
    <ComponentListing components={modules} slot="listing-components" client:load />
</ListingLayout>
